ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace_with_a_strong_random_secret_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://game.codebn.cn,http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:////www/data/game-backend/code_adventure.db
REDIS_URL=redis://127.0.0.1:6379/0
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
INTERNAL_REWARD_TOKEN=
TYPING_DATA_DIR=/www/data/game-backend/typing

# Typing trainer TTS providers
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_ENDPOINT=https://api.minimax.io/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE=female-shaonv

# Qwen / DashScope fallback
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
