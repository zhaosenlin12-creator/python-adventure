export interface BattleConfig {
    enemyName: string;
    enemyAvatar: string; // Emoji or URL
    enemyHp: number;
    enemyMaxHp: number;
    enemyAttack: number;
    playerHp: number;
    playerMaxHp: number;
}

export interface Level {
    id: string;
    chapter: number;        // Chapter number (1, 2, 3, 4)
    chapterTitle: string;   // Chapter title in English
    chapterTitleCN?: string; // Chapter title in Chinese
    title: string;
    titleCN?: string;
    description: string;
    descriptionCN?: string;
    x: number;
    y: number;
    reqLevel: number;
    type: 'lesson' | 'boss' | 'battle';
    initialCode: string;
    expectedOutput?: string; // Simple string match
    validationKeyword?: string; // Keyword check
    battle?: BattleConfig; // Optional battle config
}

