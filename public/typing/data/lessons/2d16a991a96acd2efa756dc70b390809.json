        "text": [
          "// 计算斐波那契数列\\nfunction fibonacciRecursive(n) {\\n    if (n <= 1) return n;\\n    return fibonacciRecursive(n - 1) + fibonacciRecursive(n - 2);\\n}\\n\\nfunction fibonacciIterative(n) {\\n    if (n <= 1) return n;\\n\\n    let a = 0, b = 1;\\n    for (let i = 2; i <= n; i++) {\\n        [a, b] = [b, a + b];\\n    }\\n    return b;\\n}\\n\\n// 生成斐波那契数列\\nconsole.log(\"斐波那契数列前10项:\");\\nconst fibSequence = Array.from({ length: 10 }, (_, i) => fibonacciIterative(i));\\nconsole.log(fibSequence.join(\", \"));\\n\\nconsole.log(`\\n第10项的值: ${fibonacciRecursive(10)}`);\\n\\n"
