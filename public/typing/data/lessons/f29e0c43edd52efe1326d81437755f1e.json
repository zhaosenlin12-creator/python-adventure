        "text": [
          "// 插入排序算法\\nfunction insertionSort(arr) {\\n    for (let i = 1; i < arr.length; i++) {\\n        const key = arr[i];\\n        let j = i - 1;\\n\\n        while (j >= 0 && arr[j] > key) {\\n            arr[j + 1] = arr[j];\\n            j--;\\n        }\\n\\n        arr[j + 1] = key;\\n    }\\n\\n    return arr;\\n}\\n\\n// 测试插入排序\\nconst numbers = [12, 11, 13, 5, 6];\\nconsole.log(`排序前: ${numbers}`);\\nconst sorted = insertionSort([...numbers]);\\nconsole.log(`排序后: ${sorted}`);\\n\\n"
        ],
