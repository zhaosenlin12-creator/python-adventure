        "text": [
          "package main\\n\\nimport \"fmt\"\\n\\nfunc factorialRecursive(n int) int {\\n\tif n <= 1 {\\n\t\treturn 1\\n\t}\\n\treturn n * factorialRecursive(n-1)\\n}\\n\\nfunc factorialIterative(n int) int {\\n\tresult := 1\\n\tfor i := 2; i <= n; i++ {\\n\t\tresult *= i\\n\t}\\n\treturn result\\n}\\n\\nfunc main() {\\n\tnumbers := []int{5, 6, 7, 8}\\n\\n\tfmt.Println(\"阶乘计算结果:\")\\n\tfor _, num := range numbers {\\n\t\tfmt.Printf(\"%d! = %d\\n\", num, factorialRecursive(num))\\n\t}\\n\\n\tn := 10\\n\tfmt.Printf(\"\\n递归方法: %d! = %d\\n\", n, factorialRecursive(n))\\n\tfmt.Printf(\"迭代方法: %d! = %d\\n\", n, factorialIterative(n))\\n}\\n\\n"
