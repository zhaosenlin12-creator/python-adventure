        "text": [
          "# 选择排序算法\\ndef selection_sort(arr):\\n    n = len(arr)\\n\\n    for i in range(n):\\n        # 找到未排序部分的最小元素\\n        min_index = i\\n\\n        for j in range(i + 1, n):\\n            if arr[j] < arr[min_index]:\\n                min_index = j\\n\\n        # 将最小元素放到已排序部分的末尾\\n        arr[i], arr[min_index] = arr[min_index], arr[i]\\n\\n    return arr\\n\\n# 测试选择排序\\nnumbers = [64, 25, 12, 22, 11]\\nprint(f\"原数组: {numbers}\")\\nsorted_numbers = selection_sort(numbers.copy())\\nprint(f\"排序后: {sorted_numbers}\")\\n\\n"
