        "text": [
          "# 计算斐波那契数列\\ndef fibonacci_recursive(n):\\n    if n <= 1:\\n        return n\\n    return fibonacci_recursive(n - 1) + fibonacci_recursive(n - 2)\\n\\ndef fibonacci_iterative(n):\\n    if n <= 1:\\n        return n\\n\\n    a, b = 0, 1\\n    for _ in range(2, n + 1):\\n        a, b = b, a + b\\n    return b\\n\\n# 生成斐波那契数列\\nprint(\"斐波那契数列前10项:\")\\nfib_sequence = [fibonacci_iterative(i) for i in range(10)]\\nprint(fib_sequence)\\n\\n# 测试递归方法\\nprint(f\"\\n第10项的值: {fibonacci_recursive(10)}\")\\n\\n"
