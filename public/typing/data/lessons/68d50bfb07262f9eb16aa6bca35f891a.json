        "text": [
          "#include <iostream>\\n#include <cmath>\\nusing namespace std;\\n\\nbool isPrime(int n) {\\n    if (n < 2) return false;\\n    for (int i = 2; i <= sqrt(n); i++) {\\n        if (n % i == 0) return false;\\n    }\\n    return true;\\n}\\n\\nint main() {\\n    int numbers[] = {2, 3, 4, 17, 20, 29};\\n\\n    for (int i = 0; i < 6; i++) {\\n        if (isPrime(numbers[i])) {\\n            cout << numbers[i] << \" 是素数\" << endl;\\n        } else {\\n            cout << numbers[i] << \" 不是素数\" << endl;\\n        }\\n    }\\n\\n    return 0;\\n}\\n\\n"
