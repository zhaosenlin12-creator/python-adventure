        "text": [
          "package main\\n\\nimport \"fmt\"\\n\\nfunc gcd(a, b int) int {\\n\tfor b != 0 {\\n\t\ta, b = b, a%b\\n\t}\\n\treturn a\\n}\\n\\nfunc gcdRecursive(a, b int) int {\\n\tif b == 0 {\\n\t\treturn a\\n\t}\\n\treturn gcdRecursive(b, a%b)\\n}\\n\\nfunc lcm(a, b int) int {\\n\treturn a * b / gcd(a, b)\\n}\\n\\nfunc main() {\\n\tpairs := [][]int{{48, 18}, {100, 75}, {17, 19}}\\n\\n\tfmt.Println(\"最大公约数和最小公倍数:\")\\n\tfor _, pair := range pairs {\\n\t\ta, b := pair[0], pair[1]\\n\t\tfmt.Printf(\"GCD(%d, %d) = %d\\n\", a, b, gcd(a, b))\\n\t\tfmt.Printf(\"LCM(%d, %d) = %d\\n\", a, b, lcm(a, b))\\n\t\tfmt.Println()\\n\t}\\n}\\n\\n"
