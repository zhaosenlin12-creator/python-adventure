        "text": [
          "# 冒泡排序算法\\ndef bubble_sort(arr):\\n    n = len(arr)\\n\\n    for i in range(n):\\n        # 标记本轮是否发生交换\\n        swapped = False\\n\\n        for j in range(0, n - i - 1):\\n            if arr[j] > arr[j + 1]:\\n                arr[j], arr[j + 1] = arr[j + 1], arr[j]\\n                swapped = True\\n\\n        # 如果没有发生交换，说明已经排序完成\\n        if not swapped:\\n            break\\n\\n    return arr\\n\\n# 测试冒泡排序\\nnumbers = [64, 34, 25, 12, 22, 11, 90]\\nprint(f\"排序前: {numbers}\")\\nsorted_numbers = bubble_sort(numbers.copy())\\nprint(f\"排序后: {sorted_numbers}\")\\n\\n"
