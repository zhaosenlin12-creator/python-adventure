        "text": [
          "# 插入排序算法\\ndef insertion_sort(arr):\\n    for i in range(1, len(arr)):\\n        key = arr[i]\\n        j = i - 1\\n\\n        # 将大于key的元素向后移动\\n        while j >= 0 and arr[j] > key:\\n            arr[j + 1] = arr[j]\\n            j -= 1\\n\\n        # 插入key到正确位置\\n        arr[j + 1] = key\\n\\n    return arr\\n\\n# 测试插入排序\\nnumbers = [12, 11, 13, 5, 6]\\nprint(f\"排序前: {numbers}\")\\nsorted_numbers = insertion_sort(numbers.copy())\\nprint(f\"排序后: {sorted_numbers}\")\\n\\n"
