        "text": [
          "package main\\n\\nimport \"fmt\"\\n\\nfunc bubbleSort(arr []int) {\\n\tn := len(arr)\\n\\n\tfor i := 0; i < n-1; i++ {\\n\t\tswapped := false\\n\\n\t\tfor j := 0; j < n-i-1; j++ {\\n\t\t\tif arr[j] > arr[j+1] {\\n\t\t\t\tarr[j], arr[j+1] = arr[j+1], arr[j]\\n\t\t\t\tswapped = true\\n\t\t\t}\\n\t\t}\\n\\n\t\tif !swapped {\\n\t\t\tbreak\\n\t\t}\\n\t}\\n}\\n\\nfunc main() {\\n\tarr := []int{64, 34, 25, 12, 22, 11, 90}\\n\tfmt.Println(\"排序前:\", arr)\\n\tbubbleSort(arr)\\n\tfmt.Println(\"排序后:\", arr)\\n}\\n\\n"
