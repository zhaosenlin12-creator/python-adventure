          "#include <iostream>\\n#include <queue>\\nusing namespace std;\\n\\nint main() {\\n    queue<string> q;\\n\\n    q.push(\"客户A\");\\n    q.push(\"客户B\");\\n    q.push(\"客户C\");\\n\\n    cout << \"队首: \" << q.front() << endl;\\n    cout << \"队列大小: \" << q.size() << endl;\\n\\n    cout << \"\\n开始服务...\" << endl;\\n    while (!q.empty()) {\\n        cout << \"服务: \" << q.front() << endl;\\n        q.pop();\\n    }\\n\\n    cout << \"\\n当前队列大小: \" << q.size() << endl;\\n\\n    return 0;\\n}\\n\\n"
