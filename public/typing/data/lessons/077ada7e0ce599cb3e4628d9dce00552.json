        "text": [
          "# 计算两个数的最大公约数\\ndef gcd_euclidean(a, b):\\n    while b:\\n        a, b = b, a % b\\n    return a\\n\\ndef gcd_recursive(a, b):\\n    if b == 0:\\n        return a\\n    return gcd_recursive(b, a % b)\\n\\ndef lcm(a, b):\\n    return abs(a * b) // gcd_euclidean(a, b)\\n\\n# 测试最大公约数和最小公倍数\\npairs = [(48, 18), (100, 75), (17, 19)]\\n\\nprint(\"最大公约数和最小公倍数:\")\\nfor a, b in pairs:\\n    print(f\"GCD({a}, {b}) = {gcd_euclidean(a, b)}\")\\n    print(f\"LCM({a}, {b}) = {lcm(a, b)}\")\\n    print()\\n\\n"
