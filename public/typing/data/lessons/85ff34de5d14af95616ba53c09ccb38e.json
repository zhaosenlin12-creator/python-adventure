          "# 找出列表中的最大值和最小值\\ndef find_max_min(numbers):\\n    max_num = numbers[0]\\n    min_num = numbers[0]\\n\\n    for num in numbers:\\n        if num > max_num:\\n            max_num = num\\n        if num < min_num:\\n            min_num = num\\n\\n    return max_num, min_num\\n\\nnums = [23, 45, 12, 67, 34, 8, 90]\\nmaximum, minimum = find_max_min(nums)\\nprint(f\"最大值: {maximum}, 最小值: {minimum}\")\\n\\n"
