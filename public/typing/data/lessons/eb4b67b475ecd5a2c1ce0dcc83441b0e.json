          "package main\\n\\nimport (\\n\t\"fmt\"\\n\t\"math\"\\n)\\n\\nfunc hanoi(n int, source, target, auxiliary rune) {\\n\tif n == 1 {\\n\t\tfmt.Printf(\"移动盘子 1 从 %c 到 %c\\n\", source, target)\\n\t\treturn\\n\t}\\n\\n\thanoi(n-1, source, auxiliary, target)\\n\tfmt.Printf(\"移动盘子 %d 从 %c 到 %c\\n\", n, source, target)\\n\thanoi(n-1, auxiliary, target, source)\\n}\\n\\nfunc countMoves(n int) int {\\n\treturn int(math.Pow(2, float64(n))) - 1\\n}\\n\\nfunc main() {\\n\tn := 3\\n\\n\tfmt.Printf(\"汉诺塔问题: %d 个盘子\\n\", n)\\n\tfmt.Printf(\"需要移动 %d 次\\n\\n\", countMoves(n))\\n\tfmt.Println(\"移动步骤:\")\\n\thanoi(n, 'A', 'C', 'B')\\n}\\n\\n"
