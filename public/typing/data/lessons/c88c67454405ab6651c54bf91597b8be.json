          "package main\\n\\nimport (\\n\t\"fmt\"\\n\t\"strings\"\\n)\\n\\nfunc isPalindrome(text string) bool {\\n\tcleaned := strings.ToLower(strings.ReplaceAll(text, \" \", \"\"))\\n\trunes := []rune(cleaned)\\n\\n\tfor i, j := 0, len(runes)-1; i < j; i, j = i+1, j-1 {\\n\t\tif runes[i] != runes[j] {\\n\t\t\treturn false\\n\t\t}\\n\t}\\n\\n\treturn true\\n}\\n\\nfunc main() {\\n\ttestStrings := []string{\"radar\", \"hello\", \"level\", \"A man a plan a canal Panama\"}\\n\\n\tfor _, str := range testStrings {\\n\t\tresult := isPalindrome(str)\\n\t\tfmt.Printf(\"'%s' 是回文: %t\\n\", str, result)\\n\t}\\n}\\n\\n"
