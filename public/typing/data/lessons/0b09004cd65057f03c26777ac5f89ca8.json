        "text": [
          "# 计算阶乘的多种方法\\ndef factorial_recursive(n):\\n    if n == 0 or n == 1:\\n        return 1\\n    return n * factorial_recursive(n - 1)\\n\\ndef factorial_iterative(n):\\n    result = 1\\n    for i in range(2, n + 1):\\n        result *= i\\n    return result\\n\\n# 测试阶乘计算\\nnumbers = [5, 6, 7, 8]\\nprint(\"阶乘计算结果:\")\\nfor num in numbers:\\n    print(f\"{num}! = {factorial_recursive(num)}\")\\n\\n# 比较两种方法的结果\\nn = 10\\nprint(f\"\\n递归方法: {n}! = {factorial_recursive(n)}\")\\nprint(f\"迭代方法: {n}! = {factorial_iterative(n)}\")\\n\\n"
