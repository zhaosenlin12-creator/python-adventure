        "text": [
          "# 判断一个数是否为素数\\ndef is_prime(n):\\n    if n < 2:\\n        return False\\n    for i in range(2, int(n ** 0.5) + 1):\\n        if n % i == 0:\\n            return False\\n    return True\\n\\n# 测试素数判断\\ntest_numbers = [2, 3, 4, 17, 20, 29]\\nfor num in test_numbers:\\n    if is_prime(num):\\n        print(f\"{num} 是素数\")\\n    else:\\n        print(f\"{num} 不是素数\")\\n\\n"
