        "text": [
          "// 判断一个数是奇数还是偶数\\nconst isEven = (number) => number % 2 === 0;\\n\\n// 测试多个数字\\nconst numbers = [10, 15, 22, 7, 30];\\n\\nfor (const num of numbers) {\\n    if (isEven(num)) {\\n        console.log(`${num} 是偶数`);\\n    } else {\\n        console.log(`${num} 是奇数`);\\n    }\\n}\\n\\n"
