        "text": [
          "# 汉诺塔问题的递归解法\\ndef hanoi(n, source, target, auxiliary):\\n    if n == 1:\\n        print(f\"移动盘子 1 从 {source} 到 {target}\")\\n        return\\n\\n    # 将n-1个盘子从源柱移到辅助柱\\n    hanoi(n - 1, source, auxiliary, target)\\n\\n    # 将第n个盘子从源柱移到目标柱\\n    print(f\"移动盘子 {n} 从 {source} 到 {target}\")\\n\\n    # 将n-1个盘子从辅助柱移到目标柱\\n    hanoi(n - 1, auxiliary, target, source)\\n\\ndef count_moves(n):\\n    return 2 ** n - 1\\n\\n# 测试汉诺塔\\nn = 3\\nprint(f\"汉诺塔问题: {n} 个盘子\")\\nprint(f\"需要移动 {count_moves(n)} 次\\n\")\\nprint(\"移动步骤:\")\\nhanoi(n, \"A\", \"C\", \"B\")\\n\\n"
