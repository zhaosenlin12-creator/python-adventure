        "text": [
          "package main\\n\\nimport \"fmt\"\\n\\nfunc fibonacciRecursive(n int) int {\\n\tif n <= 1 {\\n\t\treturn n\\n\t}\\n\treturn fibonacciRecursive(n-1) + fibonacciRecursive(n-2)\\n}\\n\\nfunc fibonacciIterative(n int) int {\\n\tif n <= 1 {\\n\t\treturn n\\n\t}\\n\\n\ta, b := 0, 1\\n\tfor i := 2; i <= n; i++ {\\n\t\ta, b = b, a+b\\n\t}\\n\treturn b\\n}\\n\\nfunc main() {\\n\tfmt.Println(\"斐波那契数列前10项:\")\\n\tfor i := 0; i < 10; i++ {\\n\t\tfmt.Print(fibonacciIterative(i), \" \")\\n\t}\\n\\n\tfmt.Printf(\"\\n\\n第10项的值: %d\\n\", fibonacciRecursive(10))\\n}\\n\\n"
