        "text": [
          "// 计算两个数的最大公约数\\nfunction gcd(a, b) {\\n    while (b !== 0) {\\n        [a, b] = [b, a % b];\\n    }\\n    return a;\\n}\\n\\nfunction gcdRecursive(a, b) {\\n    if (b === 0) return a;\\n    return gcdRecursive(b, a % b);\\n}\\n\\nfunction lcm(a, b) {\\n    return Math.abs(a * b) / gcd(a, b);\\n}\\n\\n// 测试最大公约数和最小公倍数\\nconst pairs = [[48, 18], [100, 75], [17, 19]];\\n\\nconsole.log(\"最大公约数和最小公倍数:\");\\nfor (const [a, b] of pairs) {\\n    console.log(`GCD(${a}, ${b}) = ${gcd(a, b)}`);\\n    console.log(`LCM(${a}, ${b}) = ${lcm(a, b)}`);\\n    console.log();\\n}\\n\\n"
