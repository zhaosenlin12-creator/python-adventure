        "text": [
          "// 判断一个数是否为素数\\nfunction isPrime(n) {\\n    if (n < 2) return false;\\n    for (let i = 2; i <= Math.sqrt(n); i++) {\\n        if (n % i === 0) return false;\\n    }\\n    return true;\\n}\\n\\n// 测试素数判断\\nconst testNumbers = [2, 3, 4, 17, 20, 29];\\nfor (const num of testNumbers) {\\n    if (isPrime(num)) {\\n        console.log(`${num} 是素数`);\\n    } else {\\n        console.log(`${num} 不是素数`);\\n    }\\n}\\n\\n"
