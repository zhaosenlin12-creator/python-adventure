          "#include <iostream>\\nusing namespace std;\\n\\nbool isEven(int number) {\\n    return number % 2 == 0;\\n}\\n\\nint main() {\\n    int numbers[] = {10, 15, 22, 7, 30};\\n\\n    for (int i = 0; i < 5; i++) {\\n        if (isEven(numbers[i])) {\\n            cout << numbers[i] << \" 是偶数\" << endl;\\n        } else {\\n            cout << numbers[i] << \" 是奇数\" << endl;\\n        }\\n    }\\n\\n    return 0;\\n}\\n\\n"
