        "text": [
          "package main\\n\\nimport \"fmt\"\\n\\nfunc selectionSort(arr []int) {\\n\tn := len(arr)\\n\\n\tfor i := 0; i < n-1; i++ {\\n\t\tminIndex := i\\n\\n\t\tfor j := i + 1; j < n; j++ {\\n\t\t\tif arr[j] < arr[minIndex] {\\n\t\t\t\tminIndex = j\\n\t\t\t}\\n\t\t}\\n\\n\t\tarr[i], arr[minIndex] = arr[minIndex], arr[i]\\n\t}\\n}\\n\\nfunc main() {\\n\tarr := []int{64, 25, 12, 22, 11}\\n\tfmt.Println(\"原数组:\", arr)\\n\tselectionSort(arr)\\n\tfmt.Println(\"排序后:\", arr)\\n}\\n\\n"
