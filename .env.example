# 前端环境变量示例（Next.js）
# 复制此文件为 .env.local 并填入实际值
# ⚠️ 后端AI Key请在 backend/.env（生产：/www/wwwroot/game-backend/.env）中配置

# API配置
NEXT_PUBLIC_API_PORT=8000
NEXT_PUBLIC_WS_PORT=8000

# 可选：自定义API地址（如果不使用自动检测）
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com
# NEXT_PUBLIC_TYPING_URL=/typing/index.html

# DeepSeek AI配置（后端使用）
# 获取API Key: https://platform.deepseek.com/
# 后端示例：
# DEEPSEEK_API_KEY=your-api-key-here

# 享打字朗读语音（后端/服务端使用，不要放入 NEXT_PUBLIC_*）
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_GROUP_ID=your-minimax-group-id
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_TTS_VOICE=female-shaonv
# QWEN_API_KEY=your-qwen-or-dashscope-api-key
# QWEN_TTS_MODEL=qwen3-tts-flash
# QWEN_TTS_VOICE=Cherry
# Optional backend typing persistence directory.
# Production default: /www/data/game-backend/typing
# TYPING_DATA_DIR=/www/data/game-backend/typing
